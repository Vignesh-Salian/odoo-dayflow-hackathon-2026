# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Relational Database Configuration
# PostgreSQL (Recommended): postgresql+psycopg2://postgres:postgres@localhost:5432/odoo_hackathon_db
# MySQL:                  mysql+pymysql://root:password@localhost:3306/odoo_hackathon_db
# SQLite (Dev fallback):  sqlite:///./hackathon.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/odoo_hackathon_db

# Optional External API Keys (Add only if problem statement requires)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
