# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Neon Postgres (pooled for runtime, direct for migrations)
# Drop channel_binding=require if the driver fails handshake
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Later local Postgres (docker compose):
# DATABASE_URL="postgresql://dayflow:dayflow@localhost:5432/dayflow?schema=public"
# DIRECT_URL="postgresql://dayflow:dayflow@localhost:5432/dayflow?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (optional in Phase 1 — logs tokens if unset)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dayflow <noreply@dayflow.local>
APP_URL=http://localhost:5173

# Email delivery (optional). Leave SMTP_HOST empty to log emails to the console.
# Gmail: enable 2FA → App Passwords → use smtp.gmail.com:587 with the app password.
# Mailtrap / Ethereal also work for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

UPLOAD_DIR=uploads

# Optional: pretend this is "today" for check-in / presence (UTC YYYY-MM-DD).
# Leave blank for the real calendar date. Set a weekday when demos land on weekends.
# DEMO_TODAY=2026-08-21
DEMO_TODAY=
